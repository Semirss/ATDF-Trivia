NEXT_PUBLIC_SUPABASE_URL=https://your-master-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-master-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-master-service-role-key
# Generate a long random value; this encrypts the active target keys in the master project.
DATABASE_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Must be the same bot that creates the Telegram Web App button.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
